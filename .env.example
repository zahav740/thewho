# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=thewho
DB_USER=postgres
DB_PASSWORD=your_password_here
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# Environment
NODE_ENV=development

# Server Configuration
BACKEND_PORT=5100
FRONTEND_PORT=5101

# JWT Configuration
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=24h

# Security
SESSION_SECRET=your_session_secret_here

# API Keys (if needed)
# SOME_API_KEY=your_api_key_here

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads

# Email Configuration (if needed)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password

# Frontend URL
FRONTEND_URL=http://localhost:5101
BACKEND_URL=http://localhost:5100

# Beget Configuration (for production)
# BEGET_DB_HOST=your_beget_host
# BEGET_DB_PORT=3306
# BEGET_DB_NAME=your_beget_db
# BEGET_DB_USER=your_beget_user
# BEGET_DB_PASSWORD=your_beget_password

# Supabase Configuration (if using)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your_supabase_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
