@echo off
echo ===================================
echo   ТЕСТ ИСПРАВЛЕННОГО EXCEL MAPPER
echo ===================================
echo.

cd /d "%~dp0"

echo Исправленный функционал:
echo ✅ Удаление/скрытие колонок
echo ✅ Редактирование заголовков
echo ✅ Визуальные индикаторы
echo ✅ Защита обязательных полей
echo.

echo Переход в директорию frontend...
cd frontend

echo.
echo Проверка установки зависимостей...
npm list antd >nul 2>&1
if %errorlevel% neq 0 (
    echo Устанавливаем недостающие зависимости...
    npm install
)

echo.
echo Компиляция TypeScript...
npx tsc --noEmit --skipLibCheck
if %errorlevel% neq 0 (
    echo ⚠️ Есть ошибки TypeScript, но продолжаем...
)

echo.
echo Запуск frontend сервера...
start "Frontend Server" cmd /c "npm start"

echo.
echo Ожидание запуска сервера...
timeout /t 10 /nobreak >nul

echo.
echo ===================================
echo       ИНСТРУКЦИИ ПО ТЕСТИРОВАНИЮ
echo ===================================
echo.
echo 1. Откройте браузер: http://localhost:3000
echo 2. Перейдите в раздел "База данных"
echo 3. Нажмите "Импорт Excel"
echo 4. Загрузите любой Excel файл
echo.
echo ПРОВЕРЬТЕ НОВЫЙ ФУНКЦИОНАЛ:
echo.
echo 🔹 УДАЛЕНИЕ КОЛОНОК:
echo   - Нажмите "Скрыть" у любой колонки
echo   - Колонка должна стать серой
echo   - Маппинг должен очиститься
echo   - Попробуйте скрыть "Номер чертежа" (должно быть запрещено)
echo.
echo 🔹 РЕДАКТИРОВАНИЕ ЗАГОЛОВКОВ:
echo   - Нажмите иконку карандаша у заголовка
echo   - Измените текст и нажмите Enter или кнопку сохранения
echo   - Заголовок должен стать синим и жирным
echo   - Под ним должен появиться оригинальный текст
echo   - Нажмите X для сброса к оригинальному
echo.
echo 🔹 ВИЗУАЛЬНЫЕ ИНДИКАТОРЫ:
echo   - Счетчик видимых колонок в Alert
echo   - Цветные теги для колонок
echo   - Подсказки при наведении на кнопки
echo.
echo ===================================
echo      ФУНКЦИОНАЛ ИСПРАВЛЕН!
echo ===================================
echo.
pause
