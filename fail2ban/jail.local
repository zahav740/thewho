[DEFAULT]
# Базовые настройки
bantime = 3600          # Время блокировки: 1 час
findtime = 600          # Временное окно для поиска: 10 минут
maxretry = 5            # Максимальное количество попыток
backend = auto
usedns = warn

# Настройки email уведомлений (настройте SMTP)
destemail = admin@kasuf.xyz
sendername = Fail2Ban CRM Security
mta = sendmail

# Настройки действий
action = %(action_mwl)s

[nginx-http-auth]
enabled = true
port = http,https
logpath = /var/log/nginx/*error.log
maxretry = 3
bantime = 1800

[nginx-limit-req]
enabled = true
port = http,https
logpath = /var/log/nginx/*error.log
maxretry = 10
findtime = 600
bantime = 3600

[nginx-botsearch]
enabled = true
port = http,https
logpath = /var/log/nginx/*access.log
maxretry = 2
bantime = 7200

[crm-auth-failure]
enabled = true
port = http,https
logpath = /var/log/nginx/*access.log
filter = crm-auth-failure
maxretry = 5
findtime = 300
bantime = 1800

[crm-sql-injection]
enabled = true
port = http,https
logpath = /var/log/nginx/*access.log
filter = crm-sql-injection
maxretry = 1
findtime = 60
bantime = 86400  # 24 часа

[crm-xss-attack]
enabled = true
port = http,https
logpath = /var/log/nginx/*access.log
filter = crm-xss-attack
maxretry = 1
findtime = 60
bantime = 86400  # 24 часа

[crm-suspicious-ua]
enabled = true
port = http,https
logpath = /var/log/nginx/*access.log
filter = crm-suspicious-ua
maxretry = 1
findtime = 60
bantime = 3600

[ssh]
enabled = true
port = ssh
logpath = /var/log/auth.log
maxretry = 3
bantime = 3600

[postfix]
enabled = false
port = smtp,465,submission
logpath = /var/log/mail.log
maxretry = 3

[recidive]
enabled = true
logpath = /var/log/fail2ban.log
banaction = %(banaction_allports)s
bantime = 86400  # 24 часа
findtime = 86400
maxretry = 3
