/**
 * @file: DemoColumnManager.tsx
 * @description: Демонстрационная версия управления колонками для тестирования
 * @created: 2025-07-02
 */
import React, { useState } from 'react';
import { Settings, Check, Star, FileSpreadsheet, Plus, Edit3, Trash2 } from 'lucide-react';

// Демонстрационные данные
const mockDetectedColumns = [
  { name: 'Название товара', index: 0, suggested: true, suggestedSystemName: 'product_name' },
  { name: 'Количество', index: 1, suggested: true, suggestedSystemName: 'quantity' },
  { name: 'Цена', index: 2, suggested: true, suggestedSystemName: 'price' },
  { name: '№ п/п', index: 3, suggested: false, suggestedSystemName: 'row_number' },
  { name: 'Комментарий', index: 4, suggested: false, suggestedSystemName: 'comment' },
  { name: 'Дата создания', index: 5, suggested: true, suggestedSystemName: 'created_date' },
  { name: 'Статус', index: 6, suggested: true, suggestedSystemName: 'status' },
  { name: 'Артикул', index: 7, suggested: true, suggestedSystemName: 'sku' },
];

const mockTemplates = [
  {
    id: 1,
    name: 'Основные товары',
    isDefault: true,
    usageCount: 15,
    columnCount: 5,
    createdAt: '2025-07-01'
  },
  {
    id: 2,
    name: 'Полный экспорт',
    isDefault: false,
    usageCount: 8,
    columnCount: 7,
    createdAt: '2025-06-28'
  },
  {
    id: 3,
    name: 'Минимальный набор',
    isDefault: false,
    usageCount: 3,
    columnCount: 3,
    createdAt: '2025-06-25'
  }
];

export const DemoColumnManager: React.FC = () => {
  const [selectedColumns, setSelectedColumns] = useState<Set<number>>(new Set([0, 1, 2, 5, 6, 7]));
  const [showTemplateForm, setShowTemplateForm] = useState(false);
  const [templateName, setTemplateName] = useState('');
  const [isDefault, setIsDefault] = useState(false);

  const handleColumnToggle = (index: number) => {
    const newSelected = new Set(selectedColumns);
    if (newSelected.has(index)) {
      newSelected.delete(index);
    } else {
      newSelected.add(index);
    }
    setSelectedColumns(newSelected);
  };

  const handleSaveTemplate = () => {
    if (!templateName.trim()) {
      alert('Введите название шаблона');
      return;
    }
    
    alert(`Шаблон "${templateName}" сохранен с ${selectedColumns.size} колонками!`);
    setShowTemplateForm(false);
    setTemplateName('');
    setIsDefault(false);
  };

  return (
    <div className="max-w-7xl mx-auto p-6 space-y-8">
      {/* Заголовок */}
      <div>
        <h1 className="text-3xl font-bold text-gray-900 flex items-center">
          <Settings className="w-8 h-8 mr-3 text-blue-600" />
          Управление колонками Excel
        </h1>
        <p className="text-gray-600 mt-2">
          Настройка наборов колонок для обработки Excel файлов
        </p>
      </div>

      {/* Демонстрационное уведомление */}
      <div className="bg-yellow-50 border border-yellow-200 rounded-lg p-4">
        <div className="flex items-start">
          <div className="flex-shrink-0">
            <span className="text-yellow-400 text-xl">⚡</span>
          </div>
          <div className="ml-3">
            <h3 className="text-sm font-medium text-yellow-800">
              Демонстрационная версия
            </h3>
            <div className="mt-2 text-sm text-yellow-700">
              <p>Это демонстрация интерфейса управления колонками. Для полноценной работы:</p>
              <ul className="list-disc list-inside mt-1 space-y-1">
                <li>Выполните миграции базы данных: <code className="bg-yellow-100 px-1 rounded">npm run migration:run</code></li>
                <li>Перезапустите backend: <code className="bg-yellow-100 px-1 rounded">npm run start:dev</code></li>
                <li>Загрузите Excel файл и используйте его ID</li>
              </ul>
            </div>
          </div>
        </div>
      </div>

      {/* Обнаруженные колонки */}
      <div className="bg-white rounded-lg shadow-sm border">
        <div className="p-6 border-b">
          <h2 className="text-xl font-semibold text-gray-900 flex items-center">
            <FileSpreadsheet className="w-5 h-5 mr-2 text-green-600" />
            Обнаруженные колонки из Excel файла
          </h2>
          <p className="text-gray-600 mt-1">
            Выберите колонки, которые нужно включить в обработку
          </p>
        </div>

        <div className="p-6">
          <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {mockDetectedColumns.map((column) => (
              <div
                key={column.index}
                className={`border rounded-lg p-4 cursor-pointer transition-all ${
                  selectedColumns.has(column.index)
                    ? 'border-blue-500 bg-blue-50'
                    : 'border-gray-200 hover:border-gray-300'
                }`}
                onClick={() => handleColumnToggle(column.index)}
              >
                <div className="flex items-center justify-between">
                  <div className="flex-1">
                    <div className="flex items-center">
                      <input
                        type="checkbox"
                        checked={selectedColumns.has(column.index)}
                        onChange={() => handleColumnToggle(column.index)}
                        className="mr-3 rounded"
                        onClick={(e) => e.stopPropagation()}
                      />
                      <div>
                        <div className="font-medium text-gray-900">
                          {column.name}
                        </div>
                        <div className="text-sm text-gray-500">
                          → {column.suggestedSystemName}
                        </div>
                        {column.suggested && (
                          <div className="text-xs text-green-600 font-medium mt-1">
                            ✓ Рекомендуется
                          </div>
                        )}
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>

          {/* Выбранные колонки */}
          <div className="mt-6 p-4 bg-gray-50 rounded-lg">
            <div className="flex items-center justify-between mb-3">
              <h3 className="font-medium text-gray-900 flex items-center">
                <Check className="w-4 h-4 mr-1 text-blue-600" />
                Выбранные колонки ({selectedColumns.size})
              </h3>
              <button
                onClick={() => setShowTemplateForm(true)}
                className="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 flex items-center text-sm"
              >
                <Plus className="w-4 h-4 mr-1" />
                Сохранить как шаблон
              </button>
            </div>
            
            <div className="flex flex-wrap gap-2">
              {mockDetectedColumns
                .filter(col => selectedColumns.has(col.index))
                .map((col) => (
                  <span
                    key={col.index}
                    className="inline-flex items-center px-3 py-1 bg-blue-100 text-blue-800 text-sm rounded-full"
                  >
                    {col.suggestedSystemName}
                  </span>
                ))}
            </div>
          </div>
        </div>
      </div>

      {/* Форма сохранения шаблона */}
      {showTemplateForm && (
        <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
          <div className="bg-white rounded-lg p-6 max-w-md w-full mx-4">
            <h3 className="text-lg font-semibold text-gray-900 mb-4">
              Сохранить набор колонок
            </h3>
            
            <div className="space-y-4">
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">
                  Название набора
                </label>
                <input
                  type="text"
                  value={templateName}
                  onChange={(e) => setTemplateName(e.target.value)}
                  placeholder="Например: Основные данные о товарах"
                  className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                />
              </div>
              
              <div className="flex items-center">
                <input
                  type="checkbox"
                  id="isDefault"
                  checked={isDefault}
                  onChange={(e) => setIsDefault(e.target.checked)}
                  className="mr-2 rounded"
                />
                <label htmlFor="isDefault" className="text-sm text-gray-700">
                  Установить как набор по умолчанию
                </label>
              </div>
            </div>

            <div className="flex justify-end space-x-3 mt-6">
              <button
                onClick={() => setShowTemplateForm(false)}
                className="px-4 py-2 border border-gray-300 rounded-md hover:bg-gray-50"
              >
                Отмена
              </button>
              <button
                onClick={handleSaveTemplate}
                className="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700"
              >
                Сохранить
              </button>
            </div>
          </div>
        </div>
      )}

      {/* Сохраненные шаблоны */}
      <div className="bg-white rounded-lg shadow-sm border">
        <div className="p-6 border-b">
          <h2 className="text-xl font-semibold text-gray-900 flex items-center">
            <Star className="w-5 h-5 mr-2 text-yellow-600" />
            Сохраненные наборы колонок
          </h2>
          <p className="text-gray-600 mt-1">
            Ваши настроенные шаблоны для быстрого применения
          </p>
        </div>

        <div className="p-6">
          <div className="space-y-4">
            {mockTemplates.map((template) => (
              <div
                key={template.id}
                className="border border-gray-200 rounded-lg p-4 hover:shadow-md transition-shadow"
              >
                <div className="flex items-center justify-between">
                  <div className="flex-1">
                    <div className="flex items-center">
                      <h3 className="font-medium text-gray-900">{template.name}</h3>
                      {template.isDefault && (
                        <span className="ml-2 inline-flex items-center px-2 py-1 text-xs bg-yellow-100 text-yellow-800 rounded-full">
                          <Star className="w-3 h-3 mr-1" />
                          По умолчанию
                        </span>
                      )}
                    </div>
                    <div className="text-sm text-gray-600 mt-1">
                      {template.columnCount} колонок • Использований: {template.usageCount}
                    </div>
                    <div className="text-xs text-gray-500 mt-1">
                      Создан: {new Date(template.createdAt).toLocaleDateString('ru-RU')}
                    </div>
                  </div>

                  <div className="flex items-center space-x-2">
                    <button
                      onClick={() => alert(`Применяем шаблон "${template.name}"`)}
                      className="p-2 text-blue-600 hover:bg-blue-50 rounded"
                      title="Применить к файлу"
                    >
                      <FileSpreadsheet className="w-4 h-4" />
                    </button>
                    
                    <button
                      onClick={() => alert(`Редактируем шаблон "${template.name}"`)}
                      className="p-2 text-green-600 hover:bg-green-50 rounded"
                      title="Редактировать"
                    >
                      <Edit3 className="w-4 h-4" />
                    </button>
                    
                    {!template.isDefault && (
                      <button
                        onClick={() => alert(`Удаляем шаблон "${template.name}"`)}
                        className="p-2 text-red-600 hover:bg-red-50 rounded"
                        title="Удалить"
                      >
                        <Trash2 className="w-4 h-4" />
                      </button>
                    )}
                  </div>
                </div>

                {/* Предварительный просмотр колонок */}
                <div className="mt-3 flex flex-wrap gap-1">
                  {['product_name', 'quantity', 'price', 'status'].slice(0, template.columnCount).map((col, index) => (
                    <span 
                      key={index}
                      className="inline-block bg-blue-100 text-blue-800 text-xs px-2 py-1 rounded"
                    >
                      {col}
                    </span>
                  ))}
                  {template.columnCount > 4 && (
                    <span className="text-xs text-gray-500">
                      +{template.columnCount - 4} еще
                    </span>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      {/* Инструкция */}
      <div className="bg-blue-50 border border-blue-200 rounded-lg p-6">
        <h3 className="text-lg font-semibold text-blue-900 mb-3 flex items-center">
          <span className="text-blue-600 text-xl mr-2">💡</span>
          Как использовать систему управления колонками
        </h3>
        <div className="text-blue-800 space-y-2">
          <p><strong>1. Анализ файла:</strong> Система автоматически распознает все колонки в Excel файле</p>
          <p><strong>2. Умные предложения:</strong> Рекомендует самые важные колонки для включения</p>
          <p><strong>3. Выбор колонок:</strong> Отметьте нужные колонки галочками</p>
          <p><strong>4. Сохранение шаблона:</strong> Создайте именованный набор для повторного использования</p>
          <p><strong>5. Применение:</strong> Используйте сохраненные наборы для новых файлов</p>
        </div>
      </div>
    </div>
  );
};

export default DemoColumnManager;
